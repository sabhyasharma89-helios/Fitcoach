{
  "name": "fitos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FitOS: single-user personal weight-management app (PWA + Android via Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:exercises && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "sync:exercises": "tsx scripts/sync-exercises.ts",
    "validate:exercises": "tsx scripts/validate-exercises.ts",
    "cap:sync": "npm run build:android && npx cap sync android",
    "build:android": "BUILD_TARGET=android npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-health": "^8.12.1",
    "@date-fns/tz": "^1.5.0",
    "@zxing/browser": "^0.2.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
